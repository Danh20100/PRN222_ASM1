@model IEnumerable<ChatBotRAG.DataAccess.Models.Subject>
@{
    ViewData["Title"] = "Tương tác & Upload";
}

<style>
    .greeting-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        padding-bottom: 20px;
    }



    .chat-box-wrapper {
        width: 100%;
        max-width: 700px;
        transition: all 0.3s ease;
    }

    .input-container {
        background-color: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: border-color 0.2s;
    }

    .input-container:focus-within {
        border-color: #525251;
    }

    .input-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    textarea {
        flex: 1;
        background: transparent;
        border: none;
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        resize: none;
        outline: none;
        height: 24px;
        max-height: 150px;
        line-height: 1.5;
        overflow-y: hidden;
    }

    textarea::placeholder {
        color: #787877;
    }

    .icon-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        font-size: 1.1rem;
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-main);
    }
    
    .send-btn {
        color: #fff;
        background: var(--input-border);
        padding: 6px;
        border-radius: 8px;
        transition: background 0.2s;
    }
    .send-btn.active {
        background: #fff;
        color: #000;
    }



    /* File Attachment Preview */
    .file-preview {
        display: none;
        align-items: center;
        gap: 8px;
        background: #3f3f3e;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        width: fit-content;
    }

    .file-preview.active {
        display: flex;
    }

    .file-preview .remove-file {
        cursor: pointer;
        color: #f87171;
    }

    /* Chat Messages Area */
    .messages-area {
        flex: 1;
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
        overflow-y: auto;
        padding: 20px 0;
        display: none;
        flex-direction: column;
        gap: 24px;
        scrollbar-width: thin;
        scrollbar-color: var(--input-border) transparent;
    }

    .messages-area.active {
        display: flex;
    }

    .message-block {
        display: flex;
        flex-direction: column;
        gap: 8px;
        animation: fadeIn 0.3s ease-out;
    }

    .message-block.user {
        align-items: flex-end;
    }

    .message-block.bot {
        align-items: flex-start;
    }

    .message-bubble {
        padding: 12px 16px;
        border-radius: 12px;
        line-height: 1.6;
        max-width: 90%;
        white-space: pre-wrap;
    }

    .message-block.user .message-bubble {
        background: #3f3f3e;
        color: white;
    }

    .message-block.bot .message-bubble {
        background: transparent;
        color: #eaddcf;
    }
    
    .typing-indicator {
        display: none;
        gap: 4px;
        padding: 12px;
    }
    
    .typing-indicator.active {
        display: flex;
    }

    .typing-indicator span {
        width: 6px; height: 6px; background: var(--text-muted); border-radius: 50%;
        animation: pulse 1.4s infinite ease-in-out both;
    }
    .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
    .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }

    @@keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes pulse { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
</style>

<div class="messages-area" id="messagesArea">
    <!-- Messages append here -->
    <div class="typing-indicator" id="typingIndicator">
        <span></span><span></span><span></span>
    </div>
</div>

<div class="greeting-container" id="greetingContainer">
    <div class="chat-box-wrapper" id="dropZone">
        <!-- Subject Selection -->
        <div style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
            <label style="color: var(--text-muted); font-size: 0.9rem;"><i class="fa-solid fa-book"></i> Phạm vi môn học:</label>
            <select id="subjectSelect" style="background: var(--input-bg); border: 1px solid var(--input-border); color: var(--text-main); padding: 8px 12px; border-radius: 8px; font-family: inherit; font-size: 0.9rem; outline: none; flex: 1; max-width: 300px;">
                <option value="11111111-1111-1111-1111-111111111111">General (Tất cả)</option>
                @if (Model != null)
                {
                    foreach (var subject in Model)
                    {
                        <option value="@subject.Id">@subject.Name</option>
                    }
                }
            </select>
        </div>

        <div class="input-container">
            <div class="file-preview" id="filePreview">
                <i class="fa-solid fa-file-lines"></i>
                <span id="fileName">document.pdf</span>
                <i class="fa-solid fa-xmark remove-file" onclick="removeFile()"></i>
            </div>
            
            <div class="input-row">
                <!-- Hidden file input -->
                <input type="file" id="fileInput" style="display:none" accept=".pdf,.txt,.docx" onchange="handleFileSelect(event)">
                
                <button class="icon-btn" onclick="document.getElementById('fileInput').click()" title="Đính kèm file (PDF, DOCX, TXT)">
                    <i class="fa-solid fa-plus"></i>
                </button>
                
                <textarea id="messageInput" placeholder="Kéo thả file hoặc gõ câu hỏi..." oninput="autoResize(this)" onkeydown="checkEnter(event)"></textarea>
                
                <button class="icon-btn send-btn" id="sendBtn" onclick="sendMessage()">
                    <i class="fa-solid fa-arrow-up"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const textarea = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    const fileInput = document.getElementById('fileInput');
    const filePreview = document.getElementById('filePreview');
    const fileNameDisplay = document.getElementById('fileName');
    
    const dropZone = document.getElementById('dropZone');
    const messagesArea = document.getElementById('messagesArea');
    const typingIndicator = document.getElementById('typingIndicator');

    let currentSessionId = '';
    let selectedFile = null;

    // Drag and Drop Logic
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.transform = 'scale(1.02)';
    });
    
    dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dropZone.style.transform = 'scale(1)';
    });
    
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.transform = 'scale(1)';
        if (e.dataTransfer.files.length > 0) {
            fileInput.files = e.dataTransfer.files;
            handleFileSelect({ target: fileInput });
        }
    });

    function autoResize(el) {
        el.style.height = '24px';
        el.style.height = (el.scrollHeight) + 'px';
        
        if(el.value.trim().length > 0 || selectedFile != null) {
            sendBtn.classList.add('active');
        } else {
            sendBtn.classList.remove('active');
        }
    }

    function checkEnter(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    }

    function handleFileSelect(e) {
        if (e.target.files.length > 0) {
            selectedFile = e.target.files[0];
            fileNameDisplay.textContent = selectedFile.name;
            filePreview.classList.add('active');
            sendBtn.classList.add('active');
        }
    }

    function removeFile() {
        selectedFile = null;
        fileInput.value = '';
        filePreview.classList.remove('active');
        if(textarea.value.trim().length === 0) {
            sendBtn.classList.remove('active');
        }
    }
    
    // Handle paste event for files
    textarea.addEventListener('paste', e => {
        if (e.clipboardData.files.length > 0) {
            e.preventDefault();
            fileInput.files = e.clipboardData.files;
            handleFileSelect({ target: fileInput });
        }
    });

    function appendMessage(text, role) {
        const block = document.createElement('div');
        block.className = `message-block ${role}`;
        
        const bubble = document.createElement('div');
        bubble.className = 'message-bubble';
        bubble.textContent = text;
        
        block.appendChild(bubble);
        messagesArea.insertBefore(block, typingIndicator);
        messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    async function sendMessage() {
        const text = textarea.value.trim();
        if (!text && !selectedFile) return;

        // Show messages area if hidden
        messagesArea.classList.add('active');

        // Prepare UI for sending
        let userDisplayText = text;
        if (selectedFile) {
            userDisplayText = `[Đã đính kèm file: ${selectedFile.name}]\n${text}`;
        }
        
        appendMessage(userDisplayText, 'user');
        
        const formData = new FormData();
        formData.append('SessionId', currentSessionId);
        formData.append('Message', text);
        // Lấy SubjectId để xử lý giới hạn phạm vi trong tương lai
        const subjectId = document.getElementById('subjectSelect').value;
        formData.append('SubjectId', subjectId);
        
        if (selectedFile) {
            formData.append('File', selectedFile);
        }

        // Clear input
        textarea.value = '';
        textarea.style.height = '24px';
        removeFile();
        
        textarea.disabled = true;
        typingIndicator.classList.add('active');
        messagesArea.scrollTop = messagesArea.scrollHeight;

        try {
            const response = await fetch('/Chat/SendMessage', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                currentSessionId = data.sessionId;
                appendMessage(data.response, 'bot');
            } else {
                appendMessage("Lỗi kết nối máy chủ.", 'bot');
            }
        } catch (err) {
            appendMessage("Mất kết nối mạng.", 'bot');
        } finally {
            typingIndicator.classList.remove('active');
            textarea.disabled = false;
            textarea.focus();
        }
    }
</script>
