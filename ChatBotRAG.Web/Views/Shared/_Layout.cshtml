@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatBot RAG</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-color: #0f1115;
            --sidebar-bg: rgba(255, 255, 255, 0.03);
            --sidebar-border: rgba(255, 255, 255, 0.08);
            --input-bg: #1f222a;
            --input-border: rgba(255, 255, 255, 0.1);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --accent-glow: rgba(99, 102, 241, 0.5);
            --glass-bg: rgba(255, 255, 255, 0.05);
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            background-image: radial-gradient(circle at 100% 0%, rgba(99, 102, 241, 0.1), transparent 30%),
                              radial-gradient(circle at 0% 100%, rgba(168, 85, 247, 0.1), transparent 30%);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 10;
            transition: all 0.3s ease;
        }

        .sidebar-header {
            padding: 24px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--sidebar-border);
        }

        .sidebar-header i.logo-icon {
            font-size: 1.8rem;
            color: var(--accent);
            filter: drop-shadow(0 0 8px var(--accent-glow));
        }

        .sidebar-header h2 {
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0;
            background: linear-gradient(to right, #fff, #a5b4fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            flex: 1;
            padding: 20px 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .nav-item:hover, .nav-item.active {
            background: var(--glass-bg);
            color: var(--text-main);
        }
        
        .nav-item.active {
            background: rgba(99, 102, 241, 0.15);
            color: #fff;
            border: 1px solid rgba(99, 102, 241, 0.3);
        }

        .nav-item i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }

        .nav-item.active i {
            color: var(--accent);
            filter: drop-shadow(0 0 5px var(--accent-glow));
        }

        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid var(--sidebar-border);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            border-radius: 12px;
            background: rgba(0,0,0,0.2);
            border: 1px solid var(--sidebar-border);
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1rem;
            color: white;
            text-transform: uppercase;
        }

        .user-info {
            flex: 1;
            overflow: hidden;
        }

        .user-name {
            font-size: 0.9rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .logout-btn {
            color: #ef4444;
            cursor: pointer;
            padding: 6px;
            border-radius: 8px;
            transition: background 0.2s;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.1);
        }

        /* Main Content Area */
        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .top-header {
            display: none; /* Only show on mobile */
            padding: 15px 20px;
            border-bottom: 1px solid var(--sidebar-border);
            align-items: center;
            justify-content: space-between;
            background: var(--bg-color);
        }

        .content-wrapper {
            flex: 1;
            overflow-y: auto;
            position: relative;
        }
        
        .content-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px;
        }
        
        /* For Chat UI which needs full height */
        .chat-wrapper {
            max-width: 800px;
            margin: 0 auto;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: fixed;
                left: -260px;
                height: 100%;
            }
            .sidebar.open {
                left: 0;
            }
            .top-header {
                display: flex;
            }
            .content-inner {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userName = User.Identity.Name;
        var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";
        var firstLetter = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1) : "U";

        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <i class="fa-solid fa-layer-group logo-icon"></i>
                <h2>ChatBot RAG</h2>
            </div>
            
            <div class="nav-links">
                @if (User.IsInRole("Student") || User.IsInRole("student"))
                {
                    <a href="/Home/Index" class="nav-item @(Context.Request.Path == "/Home/Index" || Context.Request.Path == "/" ? "active" : "")">
                        <i class="fa-regular fa-message"></i>
                        <span>Chatbot</span>
                    </a>
                    <a href="/Home/History" class="nav-item @(Context.Request.Path == "/Home/History" ? "active" : "")">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Lịch sử Chat</span>
                    </a>
                }
                
                @if (User.IsInRole("Lecturer") || User.IsInRole("lecturer"))
                {
                    <a href="/Lecturer/Index" class="nav-item @(Context.Request.Path == "/Lecturer/Index" ? "active" : "")">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <span>Tương tác & Upload</span>
                    </a>
                    <a href="/Lecturer/Subjects" class="nav-item @(Context.Request.Path == "/Lecturer/Subjects" ? "active" : "")">
                        <i class="fa-solid fa-book"></i>
                        <span>Quản lý môn học</span>
                    </a>
                    <a href="/Lecturer/ChatLogs" class="nav-item @(Context.Request.Path == "/Lecturer/ChatLogs" ? "active" : "")">
                        <i class="fa-solid fa-list-check"></i>
                        <span>Chat Logs</span>
                    </a>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("admin"))
                {
                    <a href="/Admin/Index" class="nav-item @(Context.Request.Path == "/Admin/Index" ? "active" : "")">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Dashboard Benchmark</span>
                    </a>
                }
            </div>

            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="avatar">@firstLetter</div>
                    <div class="user-info">
                        <div class="user-name">@userName</div>
                        <div class="user-role">@userRole</div>
                    </div>
                    <a href="/Account/Logout" class="logout-btn" title="Đăng xuất">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </a>
                </div>
            </div>
        </div>

        <main>
            <div class="top-header">
                <i class="fa-solid fa-bars" style="font-size: 1.5rem; cursor: pointer;" onclick="document.getElementById('sidebar').classList.toggle('open')"></i>
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">ChatBot RAG</h3>
                <div class="avatar" style="width: 32px; height: 32px;">@firstLetter</div>
            </div>
            
            <!-- Conditional content wrapper based on page type -->
            @if(Context.Request.Path == "/" || (Context.Request.Path.Value != null && Context.Request.Path.Value.StartsWith("/Home/Index")) || (Context.Request.Path.Value != null && Context.Request.Path.Value.StartsWith("/Lecturer/Index"))) 
            {
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            } 
            else 
            {
                <div class="content-wrapper">
                    <div class="content-inner">
                        @RenderBody()
                    </div>
                </div>
            }
        </main>
    }
    else
    {
        @RenderBody()
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
