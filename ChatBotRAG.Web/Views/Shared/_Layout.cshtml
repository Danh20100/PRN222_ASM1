<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ChatBot AI RAG</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georgia:ital,wght@0,400;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-color: #212120;
            --input-bg: #2d2d2c;
            --input-border: #3f3f3e;
            --text-main: #f5f5f4;
            --text-muted: #a8a29e;
            --accent: #da7b5a;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            position: relative;
        }
        
        .header-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
        }

        .header-icon:hover {
            color: var(--text-main);
        }
    </style>
</head>
<body>
    <div class="header-icon">
        <i class="fa-regular fa-user"></i>
    </div>
    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
